# AI keys are supplied by each user per request; do not add a shared provider key here.
GROQ_TEMPERATURE=0.3
GROQ_REQUEST_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2
DEV_ERROR_DETAILS=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=8
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
APP_ENV=development
PORT=5000
HOST=127.0.0.1
MAX_REQUEST_BYTES=1048576
TRUST_PROXY_HEADERS=false
ENABLE_CODE_EXECUTION=false
MAX_RUN_CODE_LENGTH=30000
MAX_RUN_STDIN_LENGTH=8000
MAX_IMAGE_DATA_URL_LENGTH=700000
APP_BASE_URL=http://127.0.0.1:5500
API_BASE_URL=http://127.0.0.1:5000
SESSION_SECRET=replace_with_a_long_random_secret
DATABASE_URL=sqlite:///D:/codeforge/data/app.db
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_PROVIDER=local
STORAGE_BUCKET=codicraft-projects
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
AUTH_PROVIDER=local
AUTH_JWT_SECRET=replace_with_a_second_long_random_secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VISION_PROVIDER=
VISION_API_KEY=
